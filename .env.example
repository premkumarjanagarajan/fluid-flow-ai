# ──────────────────────────────────────────────────────────────
# Fluid Flow AI — Core Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and replace the placeholders with your
# personal values. The .env file is gitignored and will not be
# committed.
#
#   cp .env.example .env
#
# All tokens are optional. If not set, the MCP servers fall back
# to their default auth method (OAuth browser flow or
# unauthenticated access).
#
# IMPORTANT: VS Code reads ${env:...} from the OS process environment,
# NOT from this .env file directly. The /ff-init skill persists these
# variables to your shell profile (~/.zshrc) automatically.
#
# Manual usage (if needed):
#
# macOS/Linux:
#   source ./skills/ff-init/scripts/load-env.sh --persist .env
#
# Windows (PowerShell):
#   . .\skills\ff-init\scripts\load-env.ps1 -Persist .env
#
# After loading, restart VS Code (Cmd+Q / Ctrl+Q) so MCP servers
# can pick up the new values.
# ──────────────────────────────────────────────────────────────

# GitHub MCP Server
# Used by: .vscode/mcp.json → github server
# How to get it:
#   1. Go to https://github.com/settings/tokens
#   2. Click at the Generate new token button
#   3. Make sure to select the proper scopes.
#   4. Paste the token below
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# Atlassian MCP Server (Jira + Confluence)
# By default, the Atlassian MCP uses OAuth/SSO (browser-based login).
# If you prefer token-based auth, fill in the values below AND replace
# the atlassian server block in .vscode/mcp.json.
#
# Replace this (OAuth — current default):
#
#   "atlassian": {
#     "type": "http",
#     "url": "https://mcp.atlassian.com/v1/mcp"
#   }
#
# With this (PAT-based):
#
#   "atlassian": {
#     "command": "npx",
#     "args": ["-y", "@anthropic/atlassian-mcp-server"],
#     "env": {
#       "ATLASSIAN_SITE": "betssongroup.atlassian.net",
#       "ATLASSIAN_EMAIL": "${env:ATLASSIAN_EMAIL}",
#       "ATLASSIAN_API_TOKEN": "${env:ATLASSIAN_API_TOKEN}"
#     }
#   }
#
# How to get the token:
#   1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
#   2. Click "Generate Token", give it a label (e.g. "Fluid Flow")
#   3. Paste the token below
#   4. Set your Atlassian email (the short one)
ATLASSIAN_API_TOKEN=your-atlassian-api-token-here
ATLASSIAN_EMAIL=your-email@betsson.com

# Slack MCP Server
# Used by: .vscode/mcp.json → slack server
# Connects to the official Slack MCP server (https://mcp.slack.com/mcp)
# using a user token. This impersonates YOU — no Slack bot is involved.
#
# How to get it:
#   1. Open the Betsson Slack MCP Setup app:
#      https://slack-mcp-setup.apps.igaming-test.euc1.betsson.tech/
#   2. Click "Connect with Slack" and approve the requested permissions
#   3. Copy the token from the JSON snippet shown on the success page
#      (starts with xoxp-)
#   4. Paste the token below
#
# The setup app does NOT store your token — it is shown only once.
# If you lose it, go through the flow again.
#
# To revoke your token:
#   https://betssontech.slack.com/marketplace/A0AJMCE0W9J-slack-mcp-setup?tab=settings
#   → click "Revoke" under "Your authorization"
#
# More info: https://github.com/BetssonGroup/slack-mcp-setup
#
SLACK_TOKEN=xoxp-your-slack-user-token-here
