# ──────────────────────────────────────────────────────────────
# Fluid Flow AI — Core Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and replace the placeholders with your
# personal values. The .env file is gitignored and will not be
# committed.
#
#   cp .env.example .env
#
# All tokens are optional. If not set, the MCP servers fall back
# to their default auth method (OAuth browser flow or
# unauthenticated access).
# ──────────────────────────────────────────────────────────────

# GitHub MCP Server
# Used by: .vscode/mcp.json → github server
# How to get it:
#   1. Go to https://github.com/settings/personal-access-tokens
#   2. Click at the Generate new token button
#   3. Paste the token below
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# Atlassian MCP Server (Jira + Confluence)
# Used by: .vscode/mcp.json → atlassian server
# How to get it:
#   1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
#   2. Click "Generate Token", give it a label (e.g. "Fluid Flow")
#   3. Paste the token below
#   4. Set your Atlassian email (the short one) (used together with the token for auth)
ATLASSIAN_API_TOKEN=your-atlassian-api-token-here
ATLASSIAN_EMAIL=your-email@betsson.com

# Slack MCP Server
# Used by: .vscode/mcp.json → slack server
# How to get it:
#   1. Go to https://api.slack.com/apps and create/select your app
#   2. Under "OAuth & Permissions", copy the Bot User OAuth Token
#      (starts with xoxb-)
#   3. Required scopes: channels:read, chat:write, users:read
#   4. Paste the token below
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
