# ──────────────────────────────────────────────────────────────
# Department Fluid Flow — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and replace the placeholders with your
# personal values. The .env file is gitignored and will not be
# committed.
#
#   cp .env.example .env
#
# Add variables below for any MCP servers or integrations your
# department configures in .cursor/mcp.json or .vscode/mcp.json.
# ──────────────────────────────────────────────────────────────

# ── Examples per department ──────────────────────────────────
#
# Data team (Snowflake):
#   SNOWFLAKE_PAT=your-snowflake-pat-here
#   SNOWFLAKE_ACCOUNT=KXIOZPX-BETSSON01
#   SNOWFLAKE_WAREHOUSE=TEST_XSMALL_WH
#
# Front-end team (Figma):
#   FIGMA_PERSONAL_ACCESS_TOKEN=your-figma-pat-here
#   # https://www.figma.com/developers/api#access-tokens
#
# ─────────────────────────────────────────────────────────────